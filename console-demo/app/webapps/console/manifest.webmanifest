{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Aspectow Console",
  "short_name": "Aspectow",
  "description": "Aspectow Cluster Management & Application Monitoring Console",
  "id": "/console/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#42494e",
  "theme_color": "#212529",
  "icons": [
    {
      "src": "assets/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Cluster Nodes",
      "short_name": "Nodes",
      "description": "View and manage cluster nodes",
      "url": "./cluster/nodes/",
      "icons": [
        {
          "src": "assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Monitoring Dashboard",
      "short_name": "Monitoring",
      "description": "View real-time application and server metrics",
      "url": "./appmon/dashboard/",
      "icons": [
        {
          "src": "assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Build & Deployment",
      "short_name": "Build",
      "description": "Cluster build and deployment management",
      "url": "./cluster/build/",
      "icons": [
        {
          "src": "assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": [
    "utilities",
    "productivity",
    "developer tools"
  ]
}
