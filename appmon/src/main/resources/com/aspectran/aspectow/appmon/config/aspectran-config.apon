context: {
    name: appmon
    rules: [
        classpath:com/aspectran/aspectow/appmon/config/rules/root.xml
        /config/appmon/appmon-rules.xml
    ]
    scan: [
        com.aspectran.aspectow.appmon.common
        com.aspectran.aspectow.appmon.dashboard
        com.aspectran.aspectow.appmon.framework
        com.aspectran.aspectow.appmon.engine
        com.aspectran.aspectow.appmon.home
    ]
    profiles: {
        base: [
            appmon.standalone
            h2
        ]
        default: [
            dev
        ]
    }
}
scheduler: {
    startDelaySeconds: 2
    waitOnShutdown: true
    enabled: true
}
